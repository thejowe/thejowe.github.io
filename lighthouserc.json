{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/index.html", "/sobre-mi/index.html", "/contacto/index.html"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https?://[^/]+/index\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.55 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(sobre-mi|contacto)/index\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        }
      ]
    }
  }
}
