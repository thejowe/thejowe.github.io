---
import '../styles/global.css';
import { site } from '../config/site';
import ThemeInit from '../components/ui/ThemeInit.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Footer from '../components/sections/Footer.astro';

interface Props {
  /** Título de la página; se compone como «título · sitio». Omitir en portada. */
  title?: string;
  description?: string;
  /** Excluye la página de los buscadores. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: `${base}/`, path: '/', label: 'Inicio' },
  { href: `${base}/proyectos`, path: '/proyectos', label: 'Proyectos' },
  { href: `${base}/sobre-mi`, path: '/sobre-mi', label: 'Sobre mí' },
  { href: `${base}/contacto`, path: '/contacto', label: 'Contacto' },
];
const isCurrent = (path: string) =>
  path === '/' ? current === '/' : current === path || current.startsWith(`${path}/`);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header>
      <a href={`${base}/`} class="site-name">
        {site.name ?? site.title}
      </a>
      <nav aria-label="Principal">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
