---
import Base from '../layouts/Base.astro';
import About from '../components/sections/About.astro';
---

<Base title="Sobre mí" description="Quién soy, mi stack y mi trabajo como freelance.">
  <About>
    <p>
      Soy thejowe y desarrollo software por mi cuenta. Mi proyecto principal es una app móvil con
      Expo y Supabase, disponible en español, inglés y catalán.
    </p>
    <p>
      Stack: TypeScript, React Native, Expo, Supabase (PostgreSQL), Godot/GDScript, HTML y CSS. Este
      sitio está hecho con Astro.
    </p>
    <p>Trabajo como freelance: si tienes una app o una web en mente, escríbeme.</p>
    <p>Puedes consultar el código de estos proyectos en GitHub.</p>
  </About>
</Base>
