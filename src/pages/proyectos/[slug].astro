---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Sprite from '../../components/ui/Sprite.astro';
import { site } from '../../config/site';
import { getFeatured, repoName } from '../../data/projects';
import { getGithubSnapshot, statsFor } from '../../lib/github';
import { projectIcon } from '../../lib/pixel/sprites/projects';
import type { Project } from '../../types/project';

export const getStaticPaths = (async () => {
  const snapshot = await getGithubSnapshot(site.githubUser);
  return getFeatured().map((project) => ({
    params: { slug: project.slug },
    props: { project, stats: statsFor(snapshot.repos, repoName(project)) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  stats?: ReturnType<typeof statsFor>;
}

const { project, stats } = Astro.props;
const languages = stats?.languages.length ? stats.languages : project.stack;
const pushed = stats?.pushedAt
  ? new Intl.DateTimeFormat('es', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      new Date(stats.pushedAt),
    )
  : null;
const details = (project.details ?? []).map((d) => d.trim()).filter(Boolean);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const statusText: Record<Project['status'], string> = {
  active: 'Activo',
  maintained: 'Mantenido',
  prototype: 'Prototipo',
  archived: 'Archivado',
};
---

<Base title={project.title} description={project.summary}>
  <article class="project-detail">
    <header class="project-detail__head">
      <nav class="crumbs" aria-label="Migas de pan">
        <ol>
          <li>
            <a href={`${base}/`}>Inicio</a>
          </li>
          <li>
            <a href={`${base}/proyectos/`}>Proyectos</a>
          </li>
          <li>
            <span aria-current="page">{project.title}</span>
          </li>
        </ol>
      </nav>
      <h1 class="px-title">{project.title}</h1>
      <div class="project-detail__intro px-box px-box--lift">
        <div class="project-detail__icon px-box px-box--sunk">
          <Sprite name={projectIcon(project.slug)} scale={2} />
        </div>
        <p>{project.summary}</p>
      </div>
    </header>

    {details.length > 0 && (
      <section class="project-detail__about" aria-labelledby="about-app-title">
        <h2 id="about-app-title" class="hud-label">
          Qué es
        </h2>
        {details.map((d) => (
          <p>{d}</p>
        ))}
      </section>
    )}

    <section class="project-detail__sheet" aria-labelledby="sheet-title">
      <h2 id="sheet-title" class="hud-label">
        Ficha del objeto
      </h2>
      <dl>
        <div class="px-box px-box--sunk">
          <dt class="hud-label">Rol</dt>
          <dd>{project.role}</dd>
        </div>
        <div class="px-box px-box--sunk">
          <dt class="hud-label">Año</dt>
          <dd>{project.year}</dd>
        </div>
        <div class="px-box px-box--sunk">
          <dt class="hud-label">Estado</dt>
          <dd>{statusText[project.status]}</dd>
        </div>
        {stats && (
          <div class="px-box px-box--sunk">
            <dt class="hud-label">Estrellas</dt>
            <dd>
              <Sprite name="star" palette={{ y: 'var(--accent)' }} />
              {stats.stars}
            </dd>
          </div>
        )}
        {pushed && (
          <div class="px-box px-box--sunk">
            <dt class="hud-label">Última actividad</dt>
            <dd>
              <time datetime={stats?.pushedAt ?? undefined}>{pushed}</time>
            </dd>
          </div>
        )}
      </dl>
    </section>

    <section class="project-detail__stack" aria-labelledby="stack-title">
      <h2 id="stack-title" class="hud-label">
        Tecnologías
      </h2>
      <ul class="chips">
        {languages.map((l) => (
          <li>{l}</li>
        ))}
      </ul>
    </section>

    <nav class="project-detail__links" aria-label="Enlaces del proyecto">
      <ul>
        {project.demo && (
          <li>
            <a class="px-btn" href={project.demo} rel="noopener">
              Ver la web de la app
            </a>
          </li>
        )}
        {project.repo && (
          <li>
            <a
              class:list={['px-btn', project.demo && 'px-btn--ghost']}
              href={project.repo}
              rel="noopener"
            >
              Ver código en GitHub
            </a>
          </li>
        )}
        <li>
          <a class="px-btn px-btn--ghost" href={`${base}/proyectos/`}>
            Volver a proyectos
          </a>
        </li>
      </ul>
    </nav>
  </article>
</Base>
