---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/projects/ProjectList.astro';
import { site } from '../../config/site';
import { projects, sortByYearDesc } from '../../data/projects';
import { getGithubSnapshot } from '../../lib/github';

const snapshot = await getGithubSnapshot(site.githubUser);
const list = sortByYearDesc(projects);
---

<Base title="Proyectos" description="Cofounder, la app en la que trabajo.">
  <h1>Proyectos</h1>
  <ProjectList projects={list} repos={snapshot.repos} headingLevel={2} />
</Base>
