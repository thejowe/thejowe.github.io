---
import type { RepoStats } from '../../lib/github';
import Sprite from '../ui/Sprite.astro';

interface Props {
  repos: readonly RepoStats[];
  headingLevel?: 2 | 3;
}

const { repos, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{repos.length > 0 && (
  <section class="other-repos" aria-labelledby="other-repos-title">
    <Heading id="other-repos-title" class="px-title">
      Otros repositorios
    </Heading>
    <ul class="other-repos__grid">
      {repos.map((r) => (
        <li class="other-repos__slot px-box px-box--sunk">
          <Sprite name="cursor" class="other-repos__cursor" />
          <a href={r.url} rel="noopener">
            {r.name}
          </a>
          {r.language && <span class="other-repos__lang hud-label">{r.language}</span>}
          {r.description && <span class="other-repos__desc">{r.description}</span>}
        </li>
      ))}
    </ul>
  </section>
)}
