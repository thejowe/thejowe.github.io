---
import type { Project } from '../../types/project';
import Sprite from '../ui/Sprite.astro';

interface Props {
  projects: Project[];
  heading?: string;
}
const { projects, heading = 'Proyectos destacados' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const statusLabel: Record<Project['status'], string> = {
  active: 'En marcha',
  maintained: 'Mantenido',
  archived: 'Archivado',
  prototype: 'Prototipo',
};
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <h2 id="proyectos-title" class="px-title">
    {heading}
  </h2>
  {projects.length === 0 ? (
    <p class="empty px-box px-box--sunk">Aún no hay proyectos destacados.</p>
  ) : (
    <ol class="log">
      {projects.map((p, i) => (
        <li class="quest px-box px-box--lift">
          <div class="icon px-box px-box--sunk" aria-hidden="true">
            <Sprite name="questPhone" scale={3} />
          </div>
          <div class="body">
            <p class="hud-label">Misión {String(i + 1).padStart(2, '0')}</p>
            <h3>
              <Sprite name="cursor" scale={1} class="cursor" />
              <a href={`${base}/proyectos/${p.slug}`}>{p.title}</a>
            </h3>
            <p class="summary">{p.summary}</p>
            <ul class="stack" aria-label="Tecnologías">
              {p.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </div>
          <dl class="hud">
            <div>
              <dt class="hud-label">Año</dt>
              <dd>{p.year}</dd>
            </div>
            <div>
              <dt class="hud-label">Estado</dt>
              <dd class="status">{statusLabel[p.status]}</dd>
            </div>
            <div>
              <dt class="hud-label">Rol</dt>
              <dd>{p.role}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .log {
    display: grid;
    gap: var(--space-6);
  }
  .quest {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    margin: var(--px) calc(var(--px) * 4) calc(var(--px) * 4) var(--px);
    isolation: isolate;
  }
  .icon {
    display: grid;
    place-items: center;
    width: max-content;
    align-self: start;
    padding: var(--space-3);
    margin: var(--px);
  }
  .body {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-2);
    overflow-wrap: anywhere;
  }
  h3 a {
    text-decoration: none;
  }
  /* El enlace cubre toda la misión: objetivo grande, sin depender de hover */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cursor {
    color: var(--accent);
    visibility: hidden;
  }
  .summary {
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    padding: var(--px) calc(var(--px) * 3);
    margin: var(--px);
    background: var(--bg-2);
    color: var(--ink);
    font-size: var(--step--1);
    line-height: 1.5;
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--line),
      0 var(--px) 0 0 var(--line),
      calc(var(--px) * -1) 0 0 0 var(--line),
      var(--px) 0 0 0 var(--line);
  }
  .hud {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--px) dotted var(--line);
  }
  .hud dd {
    margin: 0;
  }
  .status {
    color: var(--moss);
  }
  .empty {
    padding: var(--space-5);
    color: var(--muted);
  }

  .quest:hover h3 a,
  .quest:focus-within h3 a {
    color: var(--accent);
  }
  .quest:hover,
  .quest:focus-within {
    --edge: var(--accent);
  }
  .quest:hover .cursor,
  .quest:focus-within .cursor {
    visibility: visible;
  }

  @media (min-width: 48rem) {
    .quest {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--space-6);
    }
    .hud {
      grid-column: 1 / -1;
    }
    .icon {
      padding: var(--space-4);
    }
  }
  @media (max-width: 30rem) {
    .hud {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .quest:hover .cursor,
    .quest:focus-within .cursor {
      animation: cursor-nudge 0.8s steps(1, end) infinite;
    }
    @keyframes cursor-nudge {
      50% {
        transform: translateX(var(--px));
      }
    }
  }
</style>
