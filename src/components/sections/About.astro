---
/** Contenedor de «Sobre mí». El texto lo aporta `contenido` por el slot. */
interface Props {
  heading?: string;
}
const { heading = 'Sobre mí' } = Astro.props;
const hasContent = Astro.slots.has('default');
---

<section class="about" aria-labelledby="about-title">
  <h1 id="about-title">{heading}</h1>
  <div class="prose">{hasContent ? <slot /> : <p class="empty">Texto pendiente.</p>}</div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
  }
  .about h1 {
    margin: 0;
  }
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .prose :global(p) {
    font-size: var(--step-0);
  }
  /* Primer párrafo como entrada: un solo salto de escala */
  .prose :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .empty {
    color: var(--muted);
  }
  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-8);
      align-items: start;
    }
    .about h1 {
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
