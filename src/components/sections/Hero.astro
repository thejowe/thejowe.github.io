---
import { site } from '../../config/site';
import Button from '../ui/Button.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const github = site.social.find((s) => s.label === 'GitHub');
---

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow rise" style="--i: 0">
    @{site.githubUser}
  </p>
  <!-- Sin animación en el h1: es el candidato a LCP -->
  <h1 id="hero-title">{site.name ?? site.title}</h1>
  {site.tagline && (
    <p class="tagline rise" style="--i: 1">
      {site.tagline}
    </p>
  )}
  <p class="actions rise" style="--i: 2">
    <Button href={`${base}/#proyectos`}>Ver proyectos</Button>
    {github && (
      <Button href={github.url} variant="ghost" external>
        GitHub
      </Button>
    )}
  </p>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-7);
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 400;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .tagline {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 36ch;
    line-height: 1.35;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    max-width: none;
    margin-top: var(--space-3);
  }
</style>
