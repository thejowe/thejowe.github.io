---
import { site } from '../../config/site';
import Button from '../ui/Button.astro';

interface Props {
  heading?: string;
}
const { heading = 'Contacto' } = Astro.props;
---

<section class="contact" aria-labelledby="contact-title">
  <h1 id="contact-title">{heading}</h1>
  <div class="body">
    <div class="intro">
      <slot />
    </div>
    <ul class="channels">
      {site.email && (
        <li>
          <Button href={`mailto:${site.email}`}>{site.email}</Button>
        </li>
      )}
      {site.social.map((s) => (
        <li>
          <Button href={s.url} variant="ghost" external>
            {s.label}
          </Button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-6);
  }
  .contact h1 {
    margin: 0;
  }
  .body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .intro {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 40ch;
  }
  .intro :global(p) {
    max-width: none;
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-8);
      align-items: start;
    }
  }
</style>
