---
import { site } from '../../config/site';
import Sprite from '../ui/Sprite.astro';

interface Props {
  heading?: string;
}
const { heading = 'Contacto' } = Astro.props;

/** Colores propios del Octocat (cara, ojos, pupilas, ventosas); el negro sale de la tinta del tema. */
const octocatPalette = { s: '#f4cbb2', w: '#ffffff', r: '#ac5d52', c: '#bfe9e0' };

/** Logo pixel de cada red por su etiqueta; cualquier otra red usa el icono genérico de código. */
const logoFor = (label: string) =>
  label.toLowerCase() === 'github'
    ? 'logo-github'
    : label.toLowerCase() === 'linkedin'
      ? 'logo-linkedin'
      : 'code';
---

<section class="contact" aria-labelledby="contact-title">
  <h1 id="contact-title" class="px-title">
    {heading}
  </h1>

  <div class="save px-box px-box--lift px-box--glow">
    <div class="save-head">
      <Sprite name="floppy" scale={3} class="floppy" />
      <p class="hud-label">Punto de guardado</p>
    </div>
    <div class="intro">
      <slot />
    </div>
    <ul class="channels">
      {site.email && (
        <li>
          <a class="px-btn" href={`mailto:${site.email}`}>
            <Sprite name="mail" scale={2} />
            <span>
              {site.email.split('@')[0]}
              <wbr />@{site.email.split('@')[1]}
            </span>
          </a>
        </li>
      )}
    </ul>
    {site.social.length > 0 && (
      <ul class="social" aria-label="Redes">
        {site.social.map((s) => (
          <li>
            <a
              class="logo px-box px-box--lift"
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              data-network={s.label.toLowerCase()}
            >
              <Sprite
                name={logoFor(s.label)}
                scale={1}
                palette={logoFor(s.label) === 'logo-github' ? octocatPalette : undefined}
              />
              <span class="visually-hidden">{s.label} (se abre en una pestaña nueva)</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-6);
  }
  .contact h1 {
    font-size: var(--step-3);
  }
  .save {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    max-width: calc(var(--px) * 190);
  }
  .save-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .floppy {
    flex: none;
  }
  .intro {
    font-size: var(--step-1);
    line-height: 1.33;
    max-width: 30ch;
  }
  .intro :global(p) {
    max-width: none;
  }
  .channels {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .channels li {
    max-width: 100%;
  }
  .channels :global(.px-btn) {
    justify-content: flex-start;
    text-align: left;
    overflow-wrap: anywhere;
    min-height: calc(var(--px) * 14);
  }
  .channels :global(.px-btn) span {
    min-width: 0;
    /* Rompe en el <wbr> tras la @ antes que en mitad de una palabra */
    overflow-wrap: break-word;
  }
  .channels :global(.px-btn--ghost) {
    color: var(--ink);
  }
  @media (max-width: 30rem) {
    .channels :global(.px-btn) {
      flex-wrap: wrap;
    }
    .save {
      padding: var(--space-4);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .floppy {
      animation: save-blink 1.6s steps(1, end) infinite;
    }
    @keyframes save-blink {
      50% {
        opacity: 0.55;
      }
    }
  }

  /* Redes: fichas con el logo en pixel art */
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .logo {
    display: grid;
    place-items: center;
    width: calc(var(--px) * 56);
    height: calc(var(--px) * 56);
    margin: var(--px);
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }
  .logo[data-network='linkedin'] :global(.sprite) {
    color: var(--moon);
  }
  .logo:hover,
  .logo:focus-visible {
    --edge: var(--accent);
    background: var(--surface-2);
  }
  .logo:hover :global(.sprite path),
  .logo:focus-visible :global(.sprite path) {
    transform: none;
  }
  .logo:active {
    transform: translate(calc(var(--px) * 2), calc(var(--px) * 2));
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
