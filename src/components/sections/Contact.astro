---
import { site } from '../../config/site';
import Sprite from '../ui/Sprite.astro';

interface Props {
  heading?: string;
}
const { heading = 'Contacto' } = Astro.props;
---

<section class="contact" aria-labelledby="contact-title">
  <h1 id="contact-title" class="px-title">
    {heading}
  </h1>

  <div class="save px-box px-box--lift px-box--glow">
    <div class="save-head">
      <Sprite name="floppy" scale={3} class="floppy" />
      <p class="hud-label">Punto de guardado</p>
    </div>
    <div class="intro">
      <slot />
    </div>
    <ul class="channels">
      {site.email && (
        <li>
          <a class="px-btn" href={`mailto:${site.email}`}>
            <Sprite name="mail" scale={2} />
            <span>
              {site.email.split('@')[0]}
              <wbr />@{site.email.split('@')[1]}
            </span>
          </a>
        </li>
      )}
    </ul>
    {site.social.length > 0 && (
      <ul class="social" aria-label="Redes">
        {site.social.map((s) => (
          <li>
            <a class="px-btn" href={s.url} target="_blank" rel="noopener noreferrer">
              {s.label}
              <span class="visually-hidden">(se abre en una pestaña nueva)</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: var(--space-6);
  }
  .contact h1 {
    font-size: var(--step-3);
  }
  .save {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    max-width: calc(var(--px) * 190);
  }
  .save-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .floppy {
    flex: none;
  }
  .intro {
    font-size: var(--step-1);
    line-height: 1.33;
    max-width: 30ch;
  }
  .intro :global(p) {
    max-width: none;
  }
  .channels {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .channels li {
    max-width: 100%;
  }
  .channels :global(.px-btn) {
    justify-content: flex-start;
    text-align: left;
    overflow-wrap: anywhere;
    min-height: calc(var(--px) * 14);
  }
  .channels :global(.px-btn) span {
    min-width: 0;
    /* Rompe en el <wbr> tras la @ antes que en mitad de una palabra */
    overflow-wrap: break-word;
  }
  .channels :global(.px-btn--ghost) {
    color: var(--ink);
  }
  @media (max-width: 30rem) {
    .channels :global(.px-btn) {
      flex-wrap: wrap;
    }
    .save {
      padding: var(--space-4);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .floppy {
      animation: save-blink 1.6s steps(1, end) infinite;
    }
    @keyframes save-blink {
      50% {
        opacity: 0.55;
      }
    }
  }

  /* Redes: botones de texto */
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
