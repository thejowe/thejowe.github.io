---
/**
 * Intro obligatoria scroll-driven: primera persona en un bosque nocturno con estética PS2.
 * El visitante camina (scroll) hacia una luz, la toca con la mano y estalla en un fundido cálido
 * que revela la página. La escena 3D vive en src/lib/intro/ (three.js, carga diferida).
 *
 * - Obligatoria: no hay botón de saltar y la página queda bloqueada hasta completarla.
 *   Excepciones necesarias: prefers-reduced-motion, sin JS o sin WebGL (nunca se atrapa a nadie).
 * - Decorativa: el canvas es aria-hidden; el contenido real vive en Hero.astro y sigue en el DOM.
 * - Siempre nocturna: colores propios, no tokens del tema.
 */
---

<script is:inline>
  // Antes del primer pintado de la intro: solo si el visitante admite movimiento.
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.documentElement.classList.add('intro-on');
  }
</script>

<div class="runway" data-intro-runway aria-hidden="true"></div>

<div class="intro" data-intro>
  <canvas class="canvas" data-canvas aria-hidden="true"></canvas>
  <p class="cue" data-cue aria-hidden="true">
    <span class="cue__text" data-cue-text>
      Cargando
    </span>
    <span class="cue__line"></span>
  </p>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const runway = document.querySelector<HTMLElement>('[data-intro-runway]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
  const cue = document.querySelector<HTMLElement>('[data-cue]');
  const cueText = document.querySelector<HTMLElement>('[data-cue-text]');
  const hero = document.getElementById('hero-title')?.closest('section') ?? null;

  const abandon = () => root.classList.remove('intro-on', 'intro-ready');

  /** Mientras la intro cubre la página, nada de lo tapado entra en el orden de tabulación. */
  const FOCUSABLE = 'a[href], button, input, select, textarea, summary, [tabindex]';
  const covered = () => {
    const roots = [
      'body > header',
      'body > footer',
      'main > :not([data-intro]):not([data-intro-runway])',
    ];
    const found = new Set<HTMLElement>();
    for (const r of roots) {
      document.querySelectorAll<HTMLElement>(r).forEach((el) => {
        if (el.matches(FOCUSABLE)) found.add(el);
        el.querySelectorAll<HTMLElement>(FOCUSABLE).forEach((f) => found.add(f));
      });
    }
    document.querySelectorAll<HTMLElement>('body > .skip-link').forEach((el) => found.add(el));
    return found;
  };
  const saved = new Map<HTMLElement, string | null>();
  const lockFocus = (on: boolean) => {
    if (on) {
      for (const el of covered()) {
        if (saved.has(el)) continue;
        saved.set(el, el.getAttribute('tabindex'));
        el.setAttribute('tabindex', '-1');
      }
      // Un control que ya tenía el foco no puede conservarlo debajo de la escena.
      if (document.activeElement instanceof HTMLElement && saved.has(document.activeElement)) {
        document.activeElement.blur();
      }
    } else {
      for (const [el, prev] of saved) {
        if (prev === null) el.removeAttribute('tabindex');
        else el.setAttribute('tabindex', prev);
      }
      saved.clear();
    }
  };

  const hasWebGL = () => {
    try {
      const gl = document.createElement('canvas').getContext('webgl2');
      gl?.getExtension('WEBGL_lose_context')?.loseContext();
      return !!gl;
    } catch {
      return false;
    }
  };

  const boot = async () => {
    if (!(intro && runway && canvas && hero)) return;
    if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      // Con movimiento reducido no se descarga la escena; si la preferencia cambia, se arranca entonces.
      matchMedia('(prefers-reduced-motion: no-preference)').addEventListener(
        'change',
        (e) => {
          if (e.matches) void boot();
        },
        { once: true },
      );
      return;
    }
    // La red de seguridad de CSS ya retiró la intro (carga muy lenta): estado terminal.
    if (root.classList.contains('intro-on') && getComputedStyle(runway).display === 'none') {
      abandon();
      return;
    }

    // Sin WebGL no se carga ni three: la página sigue directa, sin errores de consola.
    if (!hasWebGL()) {
      abandon();
      return;
    }

    let createIntroScene: typeof import('../../lib/intro/scene').createIntroScene;
    try {
      ({ createIntroScene } = await import('../../lib/intro/scene'));
    } catch {
      abandon();
      return;
    }

    const mm = gsap.matchMedia();
    // Con prefers-reduced-motion: reduce no se registra nada: la intro no existe (CSS) y el hero es directo.
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      root.classList.add('intro-on');
      let scene: Awaited<ReturnType<typeof createIntroScene>> | null = null;
      let cancelled = false;
      const proxy = { p: 0 };

      // Fin del tramo: el hero queda justo arriba del viewport (o el máximo scroll posible).
      const heroTop = () => hero.getBoundingClientRect().top + window.scrollY;

      const tl = gsap.timeline({
        paused: true,
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: runway,
          start: 0,
          end: () => Math.min(heroTop(), ScrollTrigger.maxScroll(window)),
          scrub: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => lockFocus(self.progress < 0.98),
        },
      });
      // El progreso se lo come la escena 3D; el DOM solo gestiona el cue y el fundido final.
      tl.to(proxy, { p: 1, duration: 1, onUpdate: () => scene?.setProgress(proxy.p) }, 0);
      if (cue) tl.to(cue, { autoAlpha: 0, duration: 0.05 }, 0.02);
      tl.to(intro, { autoAlpha: 0, duration: 0.05 }, 0.95);

      lockFocus(true);

      const giveUp = () => {
        cancelled = true;
        lockFocus(false);
        abandon();
        tl.scrollTrigger?.kill();
        tl.kill();
        scene?.dispose();
        scene = null;
      };
      // Mismo plazo que la red de seguridad de CSS: si la escena no llegó, se libera la página.
      const giveUpTimer = window.setTimeout(giveUp, 15000);

      createIntroScene(canvas)
        .then((s) => {
          clearTimeout(giveUpTimer);
          if (cancelled) return s.dispose();
          scene = s;
          s.setProgress(proxy.p);
          root.classList.add('intro-ready');
          if (cueText) cueText.textContent = 'Desplaza';
        })
        .catch(() => {
          // Sin WebGL: no se atrapa a nadie.
          clearTimeout(giveUpTimer);
          giveUp();
        });

      // «Saltar al contenido»: el destino real es el hero, no el principio de <main> (bajo la intro).
      const skipLink = document.querySelector<HTMLElement>('body > .skip-link');
      const onSkipLink = (e: Event) => {
        const st = tl.scrollTrigger;
        if (!st) return;
        e.preventDefault();
        window.scrollTo({ top: st.end, behavior: 'instant' });
        document.getElementById('contenido')?.focus({ preventScroll: true });
      };
      skipLink?.addEventListener('click', onSkipLink);

      const onResize = () => scene?.resize();
      window.addEventListener('resize', onResize);
      void document.fonts.ready.then(() => ScrollTrigger.refresh());

      return () => {
        cancelled = true;
        clearTimeout(giveUpTimer);
        skipLink?.removeEventListener('click', onSkipLink);
        window.removeEventListener('resize', onResize);
        scene?.dispose();
        lockFocus(false);
        abandon();
      };
    });
  };

  // three tarda en cargar y arrancar: se difiere a después de `load` y a un momento de reposo.
  const schedule = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(() => void boot())
      : setTimeout(() => void boot(), 1);
  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });
</script>

<style>
  /* Por defecto no existe: sin JS o con reduced-motion la página es el hero directo. */
  .runway,
  .intro {
    display: none;
  }
  :global(html.intro-on) .runway {
    display: block;
    /* Un recorrido largo: 70 m de bosque y el gesto final. */
    height: 420svh;
    /* Compensa el padding superior de main: el recorrido empieza en el borde de la página */
    margin-top: calc(-1 * var(--space-7));
  }
  :global(html.intro-on) .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 50;
    /* Traga clics y toques sobre lo tapado; la rueda y el táctil siguen desplazando la página */
    pointer-events: auto;
    overflow: hidden;
    /* Color de niebla de la escena: sin destello blanco mientras carga el 3D */
    background: #0a1620;
    color: #ece4d0;
    font-family: var(--font-mono);
  }
  /* Red de seguridad: si la escena no llega a arrancar, la intro se retira sola. */
  :global(html.intro-on:not(.intro-ready)) .intro {
    animation: intro-give-up 0s linear 15s forwards;
  }
  :global(html.intro-on:not(.intro-ready)) .runway {
    animation: intro-give-up-runway 0s linear 15s forwards;
  }
  @keyframes intro-give-up {
    to {
      visibility: hidden;
    }
  }
  @keyframes intro-give-up-runway {
    to {
      display: none;
    }
  }

  .canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Render interno de baja resolución, ampliado sin suavizado: el look PS2 */
    image-rendering: pixelated;
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    translate: -50% 0;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(236 228 208 / 0.8);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.8);
    max-width: none;
    will-change: opacity;
  }
  .cue__line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(rgb(236 228 208 / 0.7), transparent);
  }
</style>
