---
/**
 * Intro scroll-driven: bosque nocturno en primera persona. Una luz lejana se acerca al
 * hacer scroll; al tocarla estalla en un fundido cálido y se revela el hero.
 *
 * - Decorativa: toda la escena es aria-hidden; el contenido real vive en Hero.astro.
 * - Solo con movimiento permitido: `html.intro-on` la activa (script en línea, antes del
 *   primer pintado). Sin JS o con prefers-reduced-motion no se renderiza nada.
 * - Siempre nocturna (colores propios, no tokens): el resto de la página respeta el tema.
 */

// ── Siluetas de pinos generadas en build (determinista: mismo HTML en cada build) ──
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function pine(cx: number, base: number, h: number, w: number, tiers: number): string {
  const top = base - h;
  const right: [number, number][] = [];
  for (let k = 0; k < tiers; k++) {
    const yb = top + (h * 0.88 * (k + 1)) / tiers;
    const wk = w * (0.3 + (0.7 * (k + 1)) / tiers);
    right.push([cx + wk, yb]);
    if (k < tiers - 1) right.push([cx + wk * 0.38, yb]);
  }
  const tw = Math.max(2, w * 0.1);
  right.push([cx + tw, top + h * 0.88], [cx + tw, base]);
  const left = [...right].reverse().map(([x, y]): [number, number] => [2 * cx - x, y]);
  const pts: [number, number][] = [[cx, top], ...right, ...left];
  return 'M' + pts.map(([x, y]) => `${Math.round(x)} ${Math.round(y)}`).join('L') + 'Z';
}

interface LayerCfg {
  count: number;
  base: number;
  hMin: number;
  hMax: number;
  /** Semianchura del pasillo central libre de árboles (unidades del viewBox). */
  corridor: number;
  wRatio: number;
}

function forest(cfg: LayerCfg, seed: number): string {
  const r = rng(seed);
  let d = '';
  for (let i = 0; i < cfg.count; i++) {
    const side = i % 2 ? 1 : -1;
    const x = 600 + side * (cfg.corridor + r() * (600 - cfg.corridor + 60));
    const h = cfg.hMin + r() * (cfg.hMax - cfg.hMin);
    const w = h * cfg.wRatio * (0.85 + r() * 0.3);
    d += pine(x, cfg.base + (r() - 0.5) * 24, h, w, 4 + Math.floor(r() * 3));
  }
  return d;
}

// De lejos (1) a cerca (5). Más cerca = más grande, más oscuro y pasillo más abierto.
const layers = [
  {
    n: 1,
    d: forest({ count: 38, base: 480, hMin: 90, hMax: 170, corridor: 70, wRatio: 0.34 }, 11),
  },
  {
    n: 2,
    d: forest({ count: 22, base: 530, hMin: 170, hMax: 280, corridor: 100, wRatio: 0.34 }, 23),
  },
  {
    n: 3,
    d: forest({ count: 14, base: 610, hMin: 300, hMax: 460, corridor: 150, wRatio: 0.32 }, 37),
  },
  {
    n: 4,
    d: forest({ count: 9, base: 730, hMin: 520, hMax: 720, corridor: 210, wRatio: 0.3 }, 41),
  },
  {
    n: 5,
    d: forest({ count: 6, base: 880, hMin: 820, hMax: 1040, corridor: 290, wRatio: 0.28 }, 53),
  },
];

// Luciérnagas: posición inicial (% del lienzo) y desplazamiento hacia fuera (% de ancho/alto).
const flies = [
  { l: 44, t: 50, dx: -30, dy: -14 },
  { l: 57, t: 47, dx: 34, dy: -18 },
  { l: 51, t: 62, dx: 6, dy: 26 },
  { l: 40, t: 58, dx: -42, dy: 10 },
  { l: 61, t: 60, dx: 40, dy: 16 },
  { l: 48, t: 44, dx: -12, dy: -30 },
];
---

<script is:inline>
  // Antes del primer pintado de la intro: solo si el visitante admite movimiento.
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.documentElement.classList.add('intro-on');
  }
</script>

<div class="runway" data-intro-runway aria-hidden="true"></div>

<div class="intro" data-intro>
  <div class="scene" data-scene aria-hidden="true">
    <div class="sky"></div>

    {layers.slice(0, 2).map((l) => (
      <svg
        class={`layer layer--${l.n}`}
        data-layer
        viewBox="0 0 1200 800"
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        <path d={l.d}></path>
      </svg>
    ))}

    <div class="wisp" data-wisp>
      <div class="wisp__aura"></div>
      <div class="wisp__halo" data-halo></div>
      <div class="wisp__core"></div>
    </div>

    <div class="fog fog--a" data-fog></div>
    <svg
      class="layer layer--3"
      data-layer
      viewBox="0 0 1200 800"
      preserveAspectRatio="xMidYMid slice"
      focusable="false"
    >
      <path d={layers[2]!.d}></path>
    </svg>
    <div class="fog fog--b" data-fog></div>
    {layers.slice(3).map((l) => (
      <svg
        class={`layer layer--${l.n}`}
        data-layer
        viewBox="0 0 1200 800"
        preserveAspectRatio="xMidYMid slice"
        focusable="false"
      >
        <path d={l.d}></path>
      </svg>
    ))}

    {flies.map((f) => (
      <span
        class="fly"
        data-fly
        data-dx={f.dx}
        data-dy={f.dy}
        style={`left:${f.l}%;top:${f.t}%`}
      ></span>
    ))}

    <div class="vignette" data-vignette></div>
    <p class="cue" data-cue>
      <span>Desplaza</span>
      <span class="cue__line"></span>
    </p>
  </div>

  <div class="burst" data-burst aria-hidden="true"></div>

  <button type="button" class="skip" data-skip>
    Saltar intro
  </button>
</div>

<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const runway = document.querySelector<HTMLElement>('[data-intro-runway]');
  const hero = document.getElementById('hero-title')?.closest('section') ?? null;
  const main = document.getElementById('contenido');

  // gsap + ScrollTrigger tardan ~170 ms en arrancar: se cargan tras `load` y en reposo para no
  // sumar TBT. Hasta entonces la escena inicial ya está pintada solo con CSS.
  const boot = async () => {
    if (!(intro && runway && hero)) return;
    // La red de seguridad de CSS ya retiró la intro (carga lenta): estado terminal.
    if (root.classList.contains('intro-on') && getComputedStyle(runway).display === 'none') {
      root.classList.remove('intro-on');
      return;
    }
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);
    const mm = gsap.matchMedia();

    // Sin preferencia de reducción: animación completa. Con "reduce" no se registra nada:
    // la intro no se muestra y el hero queda directo (ver CSS: .intro solo con html.intro-on).
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      root.classList.add('intro-on');

      const q = gsap.utils.selector(intro);
      const layers = q<SVGElement>('[data-layer]');
      const flies = q<HTMLElement>('[data-fly]');
      const scene = q('[data-scene]')[0]!;
      const wisp = q('[data-wisp]')[0]!;
      const halo = q('[data-halo]')[0]!;
      const burst = q('[data-burst]')[0]!;
      const vignette = q('[data-vignette]')[0]!;
      const cue = q('[data-cue]')[0]!;
      const skip = q<HTMLButtonElement>('[data-skip]')[0]!;
      const fogs = q('[data-fog]');

      // Fin del tramo: el hero queda justo arriba del viewport al terminar.
      const shell = document.querySelectorAll(
        'main > :not([data-intro]):not([data-intro-runway]), body > footer',
      );
      const setInert = (on: boolean) => shell.forEach((el) => el.toggleAttribute('inert', on));
      setInert(true);

      const heroTop = () => hero.getBoundingClientRect().top + window.scrollY;

      // Cámara hacia delante: las capas cercanas escalan más rápido (paralaje), todas desde
      // el punto de fuga. Valores finales de cada capa de lejos (1) a cerca (5).
      const scaleEnd = [1.35, 1.9, 3, 5, 9];
      const driftX = [-3, -6, -12, -20, -32];
      // Ventana de desvanecido al pasar por la cámara (capas 3-5).
      const fade: Record<number, [number, number]> = {
        2: [0.65, 0.86],
        3: [0.5, 0.72],
        4: [0.34, 0.56],
      };

      gsap.set(layers, { transformOrigin: '50% 56%' });
      gsap.set([wisp], { transformOrigin: '0 0' });
      gsap.set(burst, { autoAlpha: 0, scale: 0.05 });

      const tl = gsap.timeline({
        paused: true,
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: runway,
          start: 0,
          end: () => Math.min(heroTop(), ScrollTrigger.maxScroll(window)),
          scrub: 1,
          invalidateOnRefresh: true,
          // Mientras la intro cubre la página, cabecera/pie no reciben foco invisible.
          onUpdate: (self) => setInert(self.progress < 0.98),
        },
      });

      // Posición en la timeline = progreso de scroll (duración total 1).
      // Fase 1 (0-0.15): bosque lejano, luz diminuta y tenue. Solo el cue se retira.
      tl.to(cue, { autoAlpha: 0, duration: 0.1 }, 0.03);

      // Fase 2 (0.15-0.7): avance. Paralaje de 5 capas, la luz crece y brilla.
      layers.forEach((layer, i) => {
        tl.to(layer, { scale: scaleEnd[i], x: driftX[i], duration: 0.75 }, 0.15);
        const f = fade[i];
        if (f) tl.to(layer, { autoAlpha: 0, duration: f[1] - f[0] }, f[0]);
      });
      tl.fromTo(
        wisp,
        { scale: 1, y: 0 },
        { scale: 8, y: () => -window.innerHeight * 0.03, duration: 0.55 },
        0.15,
      );
      tl.fromTo(halo, { opacity: 0.45 }, { opacity: 1, duration: 0.55 }, 0.15);
      tl.to(fogs, { x: (i) => (i ? 40 : -40), duration: 0.55 }, 0.15);
      tl.to(
        flies,
        {
          x: (_i, el: HTMLElement) => (Number(el.dataset.dx) * window.innerWidth) / 100,
          y: (_i, el: HTMLElement) => (Number(el.dataset.dy) * window.innerHeight) / 100,
          scale: 2.5,
          duration: 0.6,
        },
        0.15,
      );
      tl.fromTo(flies, { opacity: 0 }, { opacity: 0.9, duration: 0.12 }, 0.2);
      tl.to(flies, { opacity: 0, duration: 0.14 }, 0.62);

      // Fase 3 (0.7-0.9): la luz llena el centro; niebla y viñeta se aclaran.
      tl.to(wisp, { scale: 12, duration: 0.2 }, 0.7);
      tl.to(fogs, { opacity: 0, duration: 0.2 }, 0.7);
      tl.to(vignette, { opacity: 0.3, duration: 0.2 }, 0.7);

      // Fase 4 (0.9-0.95): "toque". Un único fundido cálido que cubre la pantalla.
      tl.to(skip, { autoAlpha: 0, duration: 0.05 }, 0.88);
      tl.to(burst, { autoAlpha: 1, scale: 6.5, ease: 'power2.out', duration: 0.05 }, 0.9);
      // Cubierto el lienzo, la escena ya no hace falta (reversible al volver atrás).
      tl.set(scene, { autoAlpha: 0 }, 0.95);

      // Fase 5 (0.95-1): el flash se disipa y deja ver el hero real.
      tl.to(burst, { autoAlpha: 0, duration: 0.05 }, 0.95);

      const onSkip = () => {
        const st = tl.scrollTrigger;
        if (!st) return;
        window.scrollTo({ top: st.end, behavior: 'instant' });
        // Sin el recorrido suavizado del scrub: nada de flash comprimido en unos fotogramas.
        tl.progress(1);
        main?.focus({ preventScroll: true });
      };
      skip.addEventListener('click', onSkip);
      const skipLink = document.querySelector<HTMLElement>('body > .skip-link');
      skipLink?.addEventListener('click', onSkip);

      // La posición del hero depende de las fuentes: recalcular al cargarlas.
      void document.fonts.ready.then(() => ScrollTrigger.refresh());
      root.classList.add('intro-ready');

      return () => {
        skip.removeEventListener('click', onSkip);
        skipLink?.removeEventListener('click', onSkip);
        setInert(false);
        root.classList.remove('intro-on', 'intro-ready');
      };
    });
  };

  const schedule = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(() => void boot())
      : setTimeout(() => void boot(), 1);
  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });
</script>

<style>
  /* Por defecto no existe: sin JS o con reduced-motion la página es el hero directo. */
  .runway,
  .intro {
    display: none;
  }
  :global(html.intro-on) .runway {
    display: block;
    height: 300svh;
    /* Compensa el padding superior de main: el recorrido empieza en el borde de la página */
    margin-top: calc(-1 * var(--space-7));
  }
  :global(html.intro-on) .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    overflow: hidden;
    color: #ece4d0;
    font-family: var(--font-mono);
  }
  /* La cabecera sigue accesible sobre la escena (misma navegación, colores nocturnos). */
  :global(html.intro-on) :global(body > header) {
    position: relative;
    z-index: 60;
    --ink: #ece4d0;
    --muted: #b9b2a2;
    --line: rgb(236 228 208 / 0.25);
    --accent: #f2a37c;
    --focus: #ffe2ae;
    --surface: rgb(236 228 208 / 0.1);
    --bg: #04060b;
  }
  /* Red de seguridad: si el script no llega a arrancar, la intro se retira sola. */
  :global(html.intro-on:not(.intro-ready)) .intro {
    animation: intro-give-up 0s linear 8s forwards;
  }
  :global(html.intro-on:not(.intro-ready)) .runway {
    animation: intro-give-up-runway 0s linear 8s forwards;
  }
  @keyframes intro-give-up {
    to {
      visibility: hidden;
    }
  }
  @keyframes intro-give-up-runway {
    to {
      display: none;
    }
  }

  .scene,
  .sky,
  .layer,
  .fog,
  .vignette,
  .burst {
    position: absolute;
  }
  .scene,
  .sky,
  .layer,
  .vignette {
    inset: 0;
  }

  .sky {
    background:
      radial-gradient(ellipse 60% 40% at 50% 56%, rgb(255 196 120 / 0.1), transparent 70%),
      radial-gradient(1.5px 1.5px at 12% 14%, #fff, transparent),
      radial-gradient(1px 1px at 27% 8%, #cfd9ff, transparent),
      radial-gradient(1.5px 1.5px at 38% 22%, #fff, transparent),
      radial-gradient(1px 1px at 64% 11%, #cfd9ff, transparent),
      radial-gradient(1.5px 1.5px at 78% 19%, #fff, transparent),
      radial-gradient(1px 1px at 90% 7%, #cfd9ff, transparent),
      radial-gradient(1px 1px at 8% 31%, #cfd9ff, transparent),
      radial-gradient(1px 1px at 85% 33%, #fff, transparent),
      linear-gradient(#03050a 0%, #09121d 45%, #13202b 58%, #070c12 62%, #020306 100%);
  }

  .layer {
    width: 100%;
    height: 100%;
    will-change: transform, opacity;
  }
  .layer--1 path {
    fill: #1a2a37;
  }
  .layer--2 path {
    fill: #132029;
  }
  .layer--3 path {
    fill: #0c161e;
  }
  .layer--4 path {
    fill: #070d13;
  }
  .layer--5 path {
    fill: #03060a;
  }

  /* Luz: el origen del grupo es su centro, los hijos se centran con márgenes. */
  .wisp {
    position: absolute;
    left: 50%;
    top: 56%;
    width: 0;
    height: 0;
    will-change: transform;
  }
  .wisp__aura,
  .wisp__halo,
  .wisp__core {
    position: absolute;
    border-radius: 50%;
  }
  .wisp__aura {
    --s: 30vmin;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    background: radial-gradient(circle, rgb(255 210 140 / 0.22), transparent 68%);
  }
  .wisp__halo {
    --s: 6vmin;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    background: radial-gradient(
      circle,
      rgb(255 226 160 / 0.75),
      rgb(255 190 110 / 0.25) 45%,
      transparent 70%
    );
    will-change: opacity;
  }
  .wisp__core {
    --s: 0.7vmin;
    width: max(var(--s), 4px);
    height: max(var(--s), 4px);
    margin: calc(max(var(--s), 4px) / -2) 0 0 calc(max(var(--s), 4px) / -2);
    background: #fff8e6;
    box-shadow: 0 0 6px 2px rgb(255 232 170 / 0.8);
  }

  .fog {
    left: -10%;
    right: -10%;
    height: 34%;
    will-change: transform, opacity;
  }
  .fog--a {
    top: 44%;
    background: linear-gradient(transparent, rgb(120 150 170 / 0.16) 50%, transparent);
  }
  .fog--b {
    top: 60%;
    background: linear-gradient(transparent, rgb(100 130 150 / 0.2) 55%, transparent);
  }

  .fly {
    position: absolute;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff3c8, rgb(255 210 130 / 0.4) 55%, transparent 70%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .vignette {
    background: radial-gradient(ellipse 75% 70% at 50% 56%, transparent 40%, rgb(0 0 0 / 0.7) 100%);
    will-change: opacity;
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-8);
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    translate: -50% 0;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(236 228 208 / 0.75);
    max-width: none;
    will-change: opacity;
  }
  .cue__line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(rgb(236 228 208 / 0.7), transparent);
  }

  /* Explosión de luz: círculo que escala hasta cubrir la pantalla desde la posición de la luz. */
  .burst {
    left: 50%;
    top: 56%;
    width: 40vmax;
    height: 40vmax;
    margin: -20vmax 0 0 -20vmax;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #fffdf4 0%,
      #fff4d6 40%,
      #ffe7b0 60%,
      rgb(255 231 176 / 0) 72%
    );
    opacity: 0;
    visibility: hidden;
    transform: scale(0.05);
    will-change: transform, opacity;
  }

  .skip {
    position: absolute;
    bottom: var(--space-5);
    right: var(--gutter);
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(236 228 208 / 0.45);
    border-radius: var(--radius-s);
    background: rgb(4 6 11 / 0.6);
    color: #ece4d0;
    font: inherit;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .skip:hover {
    border-color: #ece4d0;
    background: rgb(236 228 208 / 0.12);
  }
  /* El foco global usa la tinta del tema: aquí el fondo es siempre oscuro. */
  .skip:focus-visible {
    outline: 2px solid #ffe2ae;
    outline-offset: 3px;
  }
</style>
