---
import Sprite from '../ui/Sprite.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="nf" aria-labelledby="nf-title">
  <p class="over px-title" aria-hidden="true">
    Game over
  </p>
  <p class="end hud-label" aria-hidden="true">
    Fin de la partida
  </p>

  <div class="screen px-box px-box--lift">
    <div class="lives" aria-hidden="true">
      <Sprite name="skull" scale={4} class="skull" />
      <div class="hearts">
        <Sprite name="heartEmpty" scale={2} />
        <Sprite name="heartEmpty" scale={2} />
        <Sprite name="heartEmpty" scale={2} />
      </div>
      <p class="code">404</p>
    </div>
    <div class="msg">
      <h1 id="nf-title">Esta página no existe</h1>
      <p>La dirección está mal escrita o la página cambió de sitio.</p>
      <p class="actions">
        <a class="px-btn" href={`${base}/`}>
          <Sprite name="cursor" scale={1} palette={{ a: 'var(--accent-ink)' }} />
          Continuar<span class="sr-only"> (volver al inicio)</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .nf {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-6);
    justify-items: start;
  }
  .over {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-5);
    line-height: 1;
    color: var(--danger);
    text-transform: uppercase;
    max-width: none;
    overflow-wrap: anywhere;
  }
  .end {
    margin-bottom: var(--space-4);
    letter-spacing: 0.2em;
  }
  .screen {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    width: 100%;
    max-width: calc(var(--px) * 200);
  }
  .lives {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .hearts {
    display: flex;
    gap: var(--space-1);
  }
  .code {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--accent);
    margin-left: auto;
  }
  .msg {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .msg h1 {
    font-size: var(--step-2);
  }
  .actions {
    margin-top: var(--space-2);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .over {
      animation: over-flash 1.6s steps(1, end) infinite;
    }
    .skull {
      animation: skull-hop 2.4s steps(1, end) infinite;
    }
    @keyframes over-flash {
      0%,
      70% {
        opacity: 1;
      }
      85% {
        opacity: 0.35;
      }
    }
    @keyframes skull-hop {
      60% {
        transform: translateY(calc(var(--px) * -1));
      }
    }
  }
</style>
