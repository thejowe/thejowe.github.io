---
import Button from '../ui/Button.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="nf" aria-labelledby="nf-title">
  <p class="code" aria-hidden="true">
    404
  </p>
  <h1 id="nf-title">Esta página no existe</h1>
  <p>La dirección está mal escrita o la página cambió de sitio.</p>
  <p class="actions">
    <Button href={`${base}/`}>Volver al inicio</Button>
  </p>
</section>

<style>
  .nf {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-7);
  }
  .code {
    font-family: var(--font-mono);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.05em;
  }
  .actions {
    margin-top: var(--space-3);
  }
</style>
