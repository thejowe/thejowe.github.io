---
/** Etiqueta pixel: chip de panel hundido. */
---

<span class="tag">
  <slot />
</span>

<style>
  .tag {
    display: inline-block;
    margin: var(--px);
    padding: 0 calc(var(--px) * 2);
    background: var(--bg-2);
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--line),
      0 var(--px) 0 0 var(--line),
      calc(var(--px) * -1) 0 0 0 var(--line),
      var(--px) 0 0 0 var(--line),
      inset var(--px) var(--px) 0 0 color-mix(in srgb, var(--line-lo) 80%, transparent);
    font-family: var(--font-label);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
