---
import Sprite from './Sprite.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  external?: boolean;
}
const { href, variant = 'primary', external = false } = Astro.props;
---

<a
  class:list={['px-btn', variant === 'ghost' && 'px-btn--ghost']}
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
  {external && <Sprite name="arrow-ext" palette={{ a: 'currentColor' }} />}
</a>
