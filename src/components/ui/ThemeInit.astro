---
/**
 * Va en <head> de Base.astro, ANTES de cualquier CSS/bloque de render.
 * Noche es el tema por defecto (sin atributo); aquí solo se aplica el guardado antes del primer
 * pintado (sin flash). Ya no se sigue prefers-color-scheme. Sin dependencias.
 */
---

<script is:inline>
  try {
    const t = localStorage.getItem('theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  } catch {
    /* almacenamiento no disponible: se queda la Noche por defecto */
  }
</script>
