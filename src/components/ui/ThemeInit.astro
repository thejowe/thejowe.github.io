---
/**
 * Va en <head> de Base.astro, ANTES de cualquier CSS/bloque de render.
 * Aplica el tema guardado antes del primer pintado (sin flash). Sin dependencias.
 */
---

<script is:inline>
  try {
    const t = localStorage.getItem('theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  } catch {
    /* almacenamiento no disponible: se usa el tema del sistema */
  }
</script>
