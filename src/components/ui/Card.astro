---
/** Panel de juego (.px-box): superficie con esquinas escalonadas y bisel. Sin hover obligatorio. */
interface Props {
  as?: 'article' | 'div' | 'section';
}
const { as: Tag = 'div' } = Astro.props;
---

<Tag class="card px-box">
  <slot />
</Tag>

<style>
  .card {
    padding: calc(var(--px) * 5);
    overflow-wrap: anywhere;
  }
</style>
