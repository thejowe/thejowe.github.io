---
/** Contenedor sobrio: superficie sutil, borde fino. Sin sombra pesada ni hover obligatorio. */
interface Props {
  as?: 'article' | 'div' | 'section';
}
const { as: Tag = 'div' } = Astro.props;
---

<Tag class="card">
  <slot />
</Tag>

<style>
  .card {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
</style>
