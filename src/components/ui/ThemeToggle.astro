---
/** Alterna claro/oscuro y lo persiste. Funciona sobre html[data-theme]; ver ThemeInit.astro. */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Modo oscuro"
>
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="8.25"></circle>
    <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;

  function sync() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isDark()));
    });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('[data-theme-toggle]')) return;
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* almacenamiento no disponible: el cambio vale para esta página */
    }
    sync();
  });

  // Sin preferencia guardada, el tema sigue al sistema: mantener aria-pressed al día
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* El icono muestra el estado: mitad rellena girada en oscuro */
  .theme-toggle svg {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .theme-toggle[aria-pressed='true'] svg {
    transform: rotate(180deg);
  }
</style>
