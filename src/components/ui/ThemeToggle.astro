---
/**
 * Alterna Noche (por defecto) ↔ Amanecer y lo persiste. Funciona sobre html[data-theme]; ver
 * ThemeInit.astro. aria-pressed = Amanecer activo. El icono muestra el tema actual.
 */
import Sprite from './Sprite.astro';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Tema amanecer"
>
  <span class="ico ico--moon">
    <Sprite name="icon-moon" />
  </span>
  <span class="ico ico--sun">
    <Sprite name="icon-sun" />
  </span>
</button>

<script>
  const root = document.documentElement;
  const isLight = () => root.dataset.theme === 'light';

  function sync() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isLight()));
    });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('[data-theme-toggle]')) return;
    const next = isLight() ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* almacenamiento no disponible: el cambio vale para esta página */
    }
    sync();
  });

  sync();
</script>

<style>
  .theme-toggle {
    --edge: var(--line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: var(--px);
    margin: var(--px);
    background: var(--bg-2);
    border: 0;
    color: var(--ink);
    cursor: pointer;
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--edge),
      0 var(--px) 0 0 var(--edge),
      calc(var(--px) * -1) 0 0 0 var(--edge),
      var(--px) 0 0 0 var(--edge),
      inset var(--px) var(--px) 0 0 color-mix(in srgb, var(--line-lo) 80%, transparent),
      calc(var(--px) * 2) calc(var(--px) * 2) 0 0 var(--shadow);
  }
  .theme-toggle:hover {
    --edge: var(--accent);
    background: var(--surface-2);
  }
  .theme-toggle:active {
    transform: translate(calc(var(--px) * 2), calc(var(--px) * 2));
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--edge),
      0 var(--px) 0 0 var(--edge),
      calc(var(--px) * -1) 0 0 0 var(--edge),
      var(--px) 0 0 0 var(--edge),
      inset var(--px) var(--px) 0 0 color-mix(in srgb, var(--line-lo) 80%, transparent);
  }
  /* Noche muestra la luna; Amanecer, el sol */
  .ico {
    display: block;
  }
  .ico--sun {
    display: none;
  }
  :global(:root[data-theme='light']) .ico--moon {
    display: none;
  }
  :global(:root[data-theme='light']) .ico--sun {
    display: block;
  }
</style>
